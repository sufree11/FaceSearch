# Copy this file to "backend/.env" (no ".example") and fill it in.
# backend/.env is listed in .gitignore, so your password never ends up on GitHub.
#
# Optional Wikimedia login. Logged in, Wikimedia's rate limits follow your account instead of
# your internet connection. Create a bot password at
# https://www.mediawiki.org/wiki/Special:BotPasswords  (leave the permission boxes unticked:
# FaceSearch only reads) and copy the two values it shows you:
FS_WIKI_USER=YourUsername@FaceSearch
FS_WIKI_PASSWORD=the-long-password-shown-once
